   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "import json\n",
    "import time\n",
    "\n",
    "import pandas as pd\n",
    "import requests\n",
    "\n",
    "RAW_DIR = Path(\"data/raw\")\n",
    "PROCESSED_DIR = Path(\"data/processed\")\n",
    "\n",
    "RAW_DIR.mkdir(parents=True, exist_ok=True)\n",
    "PROCESSED_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "API_URL = \"https://api.open.fec.gov/v1/candidates/totals/\"\n",
    "STATES = [\"MI\", \"TX\", \"OH\", \"IA\"]\n",
    "HEADERS = {\n",
    "    \"User-Agent\": \"WebDataScience/1.0 (fiona.kim@colorado.edu)\"\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "e66b4069-ab63-4659-92cd-a77706d584c5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Records by state: {'MI': 25, 'TX': 41, 'OH': 16, 'IA': 12}\n",
      "Total records: 94\n",
      "Saved raw data to: data/raw/fec_2026_senate_20261108_205746.json\n"
     ]
    }
   ],
   "source": [
    "all_records = []\n",
    "record_counts = {}\n",
    "\n",
    "for state in STATES:\n",
    "    params = {\n",
    "        \"api_key\": \"DEMO_KEY\",\n",
    "        \"cycle\": 2026,\n",
    "        \"office\": \"S\",\n",
    "        \"state\": state,\n",
    "        \"per_page\": 100,\n",
    "        \"page\": 1,\n",
    "    }\n",
    "\n",
    "    state_records = []\n",
    "\n",
    "    while True:\n",
    "        response = requests.get(\n",
    "            API_URL,\n",
    "            params=params,\n",
    "            headers=HEADERS,\n",
    "            timeout=30\n",
    "        )\n",
    "        response.raise_for_status()\n",
    "\n",
    "        page_data = response.json()\n",
    "        state_records.extend(page_data.get(\"results\", []))\n",
    "\n",
    "        total_pages = page_data.get(\"pagination\", {}).get(\"pages\", 1)\n",
    "        if params[\"page\"] >= total_pages:\n",
    "            break\n",
    "\n",
    "        params[\"page\"] += 1\n",
    "        time.sleep(1)\n",
    "\n",
    "    all_records.extend(state_records)\n",
    "    record_counts[state] = len(state_records)\n",
    "    time.sleep(1)\n",
    "\n",
    "collected_at = datetime.now(timezone.utc).isoformat(timespec=\"seconds\")\n",
    "stamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n",
    "raw_file = RAW_DIR / f\"fec_2026_senate_{stamp}.json\"\n",
    "\n",
    "with raw_file.open(\"w\") as file:\n",
    "    json.dump(\n",
    "        {\n",
    "            \"source\": API_URL,\n",
    "            \"collected_at_utc\": collected_at,\n",
    "            \"filters\": {\n",
    "                \"cycle\": 2026,\n",
    "                \"office\": \"S\",\n",
    "                \"states\": STATES\n",
    "            },\n",
    "            \"record_counts_by_state\": record_counts,\n",
    "            \"results\": all_records\n",
    "        },\n",
    "        file,\n",
    "        indent=2\n",
    "    )\n",
    "\n",
    "print(\"Records by state:\", record_counts)\n",
    "print(\"Total records:\", len(all_records))\n",
    "print(\"Saved raw data to:\", raw_file)"
   ]
  },
