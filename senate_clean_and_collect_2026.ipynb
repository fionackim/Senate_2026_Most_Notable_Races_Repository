    "# First, define which columns to keep\n",
    "columns_to_keep = [\n",
    "    \"candidate_id\",\n",
    "    \"name\",\n",
    "    \"party\",\n",
    "    \"party_full\",\n",
    "    \"state\",\n",
    "    \"office\",\n",
    "    \"receipts\",\n",
    "    \"disbursements\",\n",
    "    \"cash_on_hand_end_period\",\n",
    "    \"debts_owed_by_committee\",\n",
    "    \"coverage_start_date\",\n",
    "    \"coverage_end_date\",\n",
    "    \"last_file_date\",\n",
    "]\n",
    "\n",
    "# Add missing columns to raw_df if they don't exist\n",
    "for column in columns_to_keep:\n",
    "    if column not in raw_df.columns:\n",
    "        raw_df[column] = pd.NA\n",
    "\n",
    "# Create the clean dataframe by selecting only the columns we want\n",
    "clean = raw_df[columns_to_keep].copy()\n",
    "\n",
    "# Rename columns for clarity\n",
    "clean = clean.rename(columns={\n",
    "    \"name\": \"candidate_name\",\n",
    "    \"party\": \"party_code\",\n",
    "    \"party_full\": \"party_name\",\n",
    "    \"cash_on_hand_end_period\": \"cash_on_hand\",\n",
    "    \"debts_owed_by_committee\": \"debts_owed\",\n",
    "    \"last_file_date\": \"last_filing_date\",\n",
    "})\n",
    "\n",
    "# Convert money columns to numeric\n",
    "money_columns = [\n",
    "    \"receipts\",\n",
    "    \"disbursements\",\n",
    "    \"cash_on_hand\",\n",
    "    \"debts_owed\",\n",
    "]\n",
    "\n",
    "for column in money_columns:\n",
    "    clean[column] = pd.to_numeric(clean[column], errors=\"coerce\")\n",
    "\n",
    "# Convert date columns to datetime\n",
    "date_columns = [\n",
    "    \"coverage_start_date\",\n",
    "    \"coverage_end_date\",\n",
    "    \"last_filing_date\",\n",
    "]\n",
    "\n",
    "for column in date_columns:\n",
    "    clean[column] = pd.to_datetime(clean[column], errors=\"coerce\")\n",
    "\n",
    "# Remove rows with missing critical data and duplicates\n",
    "clean = clean.dropna(subset=[\"candidate_id\", \"candidate_name\"])\n",
    "clean = clean.drop_duplicates(subset=\"candidate_id\")\n",
    "\n",
    "# Sort the data\n",
    "clean = clean.sort_values(\n",
    "    [\"state\", \"party_name\", \"candidate_name\"],\n",
    "    na_position=\"last\"\n",
    ").reset_index(drop=True)\n",
    "\n",
    "# Display summary statistics\n",
    "print(\"Cleaned rows and columns:\", clean.shape)\n",
    "print(\"Rows by state:\")\n",
    "display(clean[\"state\"].value_counts())\n",
    "print(\"Missing values:\")\n",
    "display(clean.isna().sum().to_frame(\"missing\"))\n",
    "\n",
    "display(clean.head())\n",
    "\n",
    "# NOW save the cleaned data (after 'clean' has been created and processed)\n",
    "clean.to_csv(\n",
    "    PROCESSED_DIR / \"fec_2026_senate_clean.csv\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "# Create and save a sample\n",
    "sample = (\n",
    "    clean.groupby(\"state\", group_keys=False)\n",
    "    .head(3)\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "sample.to_csv(\"data/sample_clean.csv\", index=False)\n",
    "\n",
    "print(\"Saved full cleaned data locally.\")\n",
    "print(f\"Saved a {len(sample)}-row sample to data/sample_clean.csv\")"
   ]
  },
